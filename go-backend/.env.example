# ═══════════════════════════════════════════════════════
# ENVIRONMENT VARIABLES — e-pesantren.app
# Copy file ini ke .env dan isi nilai yang sebenarnya
# JANGAN commit .env ke repository!
# ═══════════════════════════════════════════════════════

DB_HOST=localhost
DB_USER=pesantren
DB_PASS=GANTI_DENGAN_PASSWORD_AMAN
DB_NAME=pesantren_multi
PORT=3002

# JWT Secret — WAJIB minimal 32 karakter, gunakan random string
# Generate: openssl rand -hex 32
JWT_SECRET=GANTI_DENGAN_RANDOM_STRING_MINIMAL_32_KARAKTER

# CORS — domain yang diizinkan (pisahkan dengan koma)
# Untuk development, set ke: http://localhost:3002
CORS_ORIGINS=https://e-pesantren.app, https://*.e-pesantren.app
